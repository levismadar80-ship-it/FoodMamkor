# ============================================================================
# מהמקור — Frontend environment variables
# ============================================================================
# Copy to `.env.local` for local dev (Next.js auto-loads it, gitignored),
# or paste each KEY=value into Vercel's Project Settings → Environment
# Variables for production.
# ============================================================================

# --- Backend URL (used by next.config.js rewrites to proxy /api/*) ------------
# This value is read at SERVER BOOT by next.config.js and baked into the
# routes manifest at build time — a rebuild is required whenever it changes.
#
# Local (no docker):       http://localhost:8000
# docker-compose:          http://backend:8000  (set via docker-compose.yml)
# Production (Vercel):     https://<your-service>.up.railway.app
BACKEND_URL=http://localhost:8000

# Legacy fallback name — kept because next.config.js checks it. Set it to
# the same value as BACKEND_URL. (NEXT_PUBLIC_* is exposed to the browser,
# but since the proxy runs server-side this is harmless.)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Google OAuth (browser-side client id) ------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=591935721343-jjrco2vpmok72to1fm8rq1ss0i2s0cj7.apps.googleusercontent.com

# --- Apple Sign In (optional) -------------------------------------------------
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://mehamakor.online/login

# --- Public site URL (used in sitemap + OG tags) ------------------------------
NEXT_PUBLIC_SITE_URL=https://mehamakor.online

# --- Support contact (used in /settings SupportModal) -------------------------
# E.164 format without the leading +, e.g. 972501234567
NEXT_PUBLIC_SUPPORT_PHONE=972500000000
