# ============================================================================
# מהמקור — Frontend environment variables
# ============================================================================
# Copy to `.env.local` for local dev (Next.js auto-loads it, gitignored),
# or paste each KEY=value into Vercel's Project Settings → Environment
# Variables for production.
# ============================================================================

# --- Backend URL (used by next.config.js rewrites to proxy /api/*) ------------
# This value is read at SERVER BOOT by next.config.js and baked into the
# routes manifest at build time — a rebuild is required whenever it changes.
#
# Local (no docker):       http://localhost:8000
# docker-compose:          http://backend:8000  (set via docker-compose.yml)
# Production (Vercel):     https://<your-service>.up.railway.app
BACKEND_URL=http://localhost:8000

# Legacy fallback name — kept because next.config.js checks it. Set it to
# the same value as BACKEND_URL. (NEXT_PUBLIC_* is exposed to the browser,
# but since the proxy runs server-side this is harmless.)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Google OAuth (browser-side client id) ------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=591935721343-jjrco2vpmok72to1fm8rq1ss0i2s0cj7.apps.googleusercontent.com

# --- Apple Sign In (optional) -------------------------------------------------
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://mehamakor.online/login

# --- Public site URL (used in sitemap + OG tags) ------------------------------
NEXT_PUBLIC_SITE_URL=https://mehamakor.online

# --- Support contact (used in /settings SupportModal) -------------------------
# E.164 format without the leading +, e.g. 972501234567
NEXT_PUBLIC_SUPPORT_PHONE=972500000000

# --- MEH-653: Public contact email --------------------------------------------
# Single source of truth for the contact address shown on /terms, /privacy,
# /contact, /forgot-password, /accessibility. Read via lib/env.client.js
# (CONTACT_EMAIL export). Falls back to the literal contact@mehamakor.co.il
# if unset, so legal pages never show a blank email even if Vercel is missing
# the var. MUST match the backend CONTACT_EMAIL (backend/.env.example,
# backend/app/config.py::Settings.contact_email) so the displayed inbox is
# the same one that receives POST /contact submissions.
NEXT_PUBLIC_CONTACT_EMAIL=contact@mehamakor.co.il

# --- MEH-453: canonical migration ---------------------------------------------
# Phase 1 keeps the fallback at mehamakor.online so production behavior is
# unchanged. Phase 2 (DNS + Vercel + Railway + Resend + OAuth) flips the
# production value to https://mehamakor.co.il without any code change —
# update NEXT_PUBLIC_SITE_URL in Vercel and the new value cascades through
# sitemap.js / layout.js / lib/seo.js (3-tier fallback pattern).

# --- Microsoft Clarity (optional analytics) ----------------------------------
# Used by frontend/components/ClarityScript.jsx via lib/env.js.
# Set to your Clarity project ID; leave blank to disable.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Schema source of truth (MEH-454 Phase 3) --------------------------------
# All vars above are validated at build time by frontend/lib/env.js (Zod
# schema via @t3-oss/env-nextjs). Adding a new var requires updating both
# this file AND the schema in lib/env.js, otherwise the build will fail.

# --- Sentry (MEH-483 frontend SDK) -------------------------------------------
# Wired in frontend/sentry.{client,server,edge}.config.js + next.config.js.
# Leave DSN empty to disable (fail-open — Sentry init no-ops without a DSN).
#
# Browser-exposed (NEXT_PUBLIC_*) — required for client-side error capture:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=

# Server-only — used by sentry.{server,edge}.config.js. SENTRY_DSN falls
# back to NEXT_PUBLIC_SENTRY_DSN; SENTRY_ENV falls back to NODE_ENV.
SENTRY_DSN=
SENTRY_ENV=

# Build-time — Sentry CLI uploads source maps. Required for production
# stack-trace symbolication; optional in preview/local builds.
SENTRY_ORG=
SENTRY_PROJECT=
