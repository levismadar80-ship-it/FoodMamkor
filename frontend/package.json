{
  "name": "mehamakor-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "node scripts/vitest-guard.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "knip": "knip",
    "lint:ratchet": "node ../scripts/checks/lint-ratchet.mjs",
    "lint:ratchet:baseline": "node ../scripts/checks/lint-ratchet.mjs --update-baseline",
    "design:lint": "design.md lint ../docs/DESIGN.md",
    "design:export": "design.md export --format tailwind ../docs/DESIGN.md > tailwind.tokens.json",
    "codegen": "bash ../scripts/checks/openapi-codegen-drift-guard.sh --write"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.71.0",
    "@swc/helpers": "^0.5.23",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.20.0",
    "framer-motion": "^13.1.1",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.26",
    "next": "^16.3.3",
    "next-intl": "^4.14.0",
    "posthog-js": "^1.422.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.14",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "orval": "8.26.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.13",
    "vitest": "^4.1.8"
  }
