node_modules
.next/
out/
.env.local
# Playwright transient test artifacts (traces, videos, DOM dumps)
test-results/
# MEH-1980: vitest --coverage output (v8 provider). Regenerated on every run
# and machine-specific; only the frozen summary in the committed baseline is
# meant to be durable. Added with the coverage baseline itself — before it,
# any local `vitest --coverage` left the tree dirty.
coverage/
# TypeScript incremental build state. Emitted by any local `tsc` run (the e2e
# specs are TS, so verifying them writes this), machine-specific, and never
# useful in a diff. CI regenerates it per run and discards it.
*.tsbuildinfo
# MEH-2016: generated by `next build` / `next dev`, and its own header says
# "This file should not be edited". create-next-app@16.3.0 — the version this
# repo pins — ignores it in both its ts and js templates. Tracking it meant the
# committed blob went stale against the pinned Next and every build rewrote it,
# so the Stop hook's `npm run build` left the tree dirty for any session that
# had node_modules. The only consumer is tsconfig.json's `include`, which
# `next build` reads AFTER regenerating the file.
next-env.d.ts
# Auto-written by `next dev` on every start (generate-agent-files.js) — same
# class as next-env.d.ts above: a build-tool-regenerated file whose own header
# says it's re-added automatically. Its own comment suggests committing it
# ("keeps the tree clean"), but that's generic upstream Next.js advice, not
# this repo's convention — next-env.d.ts already established gitignore over
# commit for exactly this failure mode (committed blob goes stale against the
# pinned Next version, every local `next dev`/`next build` re-dirties the tree
# for any session with node_modules). Following that precedent rather than
# the file's own suggestion.
#
# Anchored with a leading slash — deliberately, not by habit. A bare
# `CLAUDE.md`/`AGENTS.md` pattern here would also match
# `components/CLAUDE.md` and `e2e/CLAUDE.md`, both real tracked docs, since
# gitignore patterns with no `/` match at any depth.
/AGENTS.md
/CLAUDE.md
# MEH-1241: per-role auth storageState written by e2e/global-setup.ts — each
# file embeds a LIVE JWT, so it must never be committed ("no credentials in repo").
e2e/.auth/

# next-pwa was removed in MEH-372 (no Turbopack support). MEH-1326 replaced
# the auto-generated worker with a hand-authored STATIC service worker at
# public/sw.js — that file is now TRACKED (push-only, no build step). The
# entries below stay ignored for the workbox/runtime artifacts next-pwa used
# to emit, so a stray local build can't reintroduce them.
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
