{
  "_about": "MEH-3699: every field the business signup request (backend ProducerRegister) carries, and where the owner gives it. signup = a locator on the business signup path (testid:/id:/text:); dashboard = an anchor in frontend/lib/dashboard-edit-anchors.js ANCHOR_TO_KEY; shown_with = a field shown only under another signup field's answer; system = not typed by the owner, with the reason. Every field needs at least one home. Removing a field from signup without a dashboard home fails RegisterProducerClient-01 «signup field homes»; a schema field missing here fails tests/test_meh3699_signup_field_homes.py.",
  "fields": {
    "email": { "signup": "testid:register-account-email" },
    "name": { "signup": "testid:register-account-name" },
    "password": { "signup": "testid:register-account-password" },
    "producer_name": { "signup": "testid:register-details-name", "dashboard": "business-name" },
    "description": { "dashboard": "bio" },
    "short_description": { "dashboard": "bio" },
    "city": { "signup": "testid:register-details-city", "dashboard": "locations" },
    "address": { "dashboard": "locations" },
    "lat": { "dashboard": "locations" },
    "lng": { "dashboard": "locations" },
    "phone": { "signup": "testid:register-details-phone", "dashboard": "contact-channels" },
    "instagram": { "dashboard": "contact-channels" },
    "website": { "dashboard": "contact-channels" },
    "external_order_form": { "dashboard": "contact-channels" },
    "primary_contact_method": { "dashboard": "contact-channels" },
    "contact_email": { "dashboard": "contact-channels" },
    "kind": { "system": "the route: /register/producer or /register/organizer" },
    "category_ids": { "signup": "id:register-category-selector", "dashboard": "categories" },
    "producer_license_number": { "shown_with": "category_ids", "dashboard": "license" },
    "license_pending": { "shown_with": "category_ids" },
    "declaration_accepted": { "signup": "text:auth.register.producer.terms.declaration" },
    "farmer_declaration_accepted": { "shown_with": "category_ids" },
    "terms_accepted": { "signup": "text:auth.register.producer.terms.intro" },
    "referral_source": { "signup": "testid:register-referral-source" },
    "referral_source_other": { "shown_with": "referral_source" },
    "has_physical_location": { "signup": "testid:register-fulfilment", "dashboard": "delivery" },
    "offers_delivery": { "signup": "testid:register-fulfilment", "dashboard": "delivery" },
    "delivery_nationwide": { "dashboard": "delivery" },
    "delivery_cities": { "dashboard": "delivery" },
    "delivery_areas": { "dashboard": "delivery" },
    "prefill_token": { "system": "the outreach link the owner arrived from (MEH-3026)" }
  }
}
