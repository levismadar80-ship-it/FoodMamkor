{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "MapClient.jsx",
              "assets/**",
              "chips-and-cards.jsx",
              "data.js",
              "frontend/components/**",
              "frontend/lib/**",
              "homepage/parts/**",
              "parts/**",
              "pins.jsx",
              "source/**",
              "ui_kits/mobile/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Frank Ruhl Libre|Cormorant Garamond|DM Sans|Heebo))/i]",
        "message": "Font not provided by the design system. Available: Frank Ruhl Libre, Cormorant Garamond, DM Sans, Heebo."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-warm",
      "--accent-warm-light",
      "--background",
      "--bg",
      "--bg-card",
      "--bg-inverse",
      "--border",
      "--container-max",
      "--dur-base",
      "--dur-fast",
      "--dur-slow",
      "--ease-out",
      "--ease-quart",
      "--fg",
      "--fg-inverse",
      "--fg-muted",
      "--focus-ring",
      "--font-body",
      "--font-english",
      "--font-headline",
      "--font-hebrew-fallback",
      "--fs-body",
      "--fs-card-title",
      "--fs-h2",
      "--fs-h3",
      "--fs-hero",
      "--fs-micro",
      "--fs-price",
      "--fs-small",
      "--lh-body",
      "--lh-hero",
      "--lh-small",
      "--lh-snug",
      "--lh-tight",
      "--light",
      "--link",
      "--link-hover",
      "--primary",
      "--primary-dark",
      "--primary-light",
      "--radius-full",
      "--radius-lg",
      "--radius-md",
      "--radius-sm",
      "--secondary",
      "--secondary-light",
      "--shadow-card",
      "--shadow-header",
      "--site-muted",
