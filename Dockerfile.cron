# MEH-468 — multi-stage build: 321 MB → ~180–210 MB.
#
# Stage 1 (builder): full apt machinery — curl + gnupg to add the PGDG apt
# repo, then postgresql-client-18 + libpq5. The entire builder layer is
# discarded after the COPY steps below.
#
# Stage 2 (runtime): slim Python base + auth-support libs from Debian main
# (no PGDG repo needed here) + pg_dump/pg_restore binaries + libpq.so.5
# copied from builder + boto3. Expected final size: 180–210 MB.
#
# postgresql-client must match the server major version. Debian bookworm
# (slim's base) ships PG 15 in its main repos — too old for our server
# (PG 18). The builder stage uses the official PostgreSQL apt repo
# (apt.postgresql.org) which publishes matched binaries for every supported
# major version. Only the binaries and libpq.so.5 transfer to the runtime.
#
# Used by a separate Railway service whose Cron Schedule is set to
# `0 23 * * *` UTC (= 02:00 IST summer / 01:00 IST winter). Per Railway
# cron contract: container starts on schedule, runs the script once,
# exits, container is destroyed.
#
# Last updated: 2026-05-07 (MEH-468).

FROM python:3.12-slim-bookworm AS builder

# Install the PGDG apt repo then postgresql-client-18.
# curl + gnupg are build-time-only tools that never enter the runtime layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/*

# ── Runtime ────────────────────────────────────────────────────────────────────
FROM python:3.12-slim-bookworm

# Install auth-support libs from Debian main (no PGDG repo needed here).
#
# ca-certificates   — TLS root trust for R2 HTTPS upload + PostgreSQL SSL.
# libgssapi-krb5-2  — libpq links against libgssapi_krb5 even when Kerberos
#                     is not the auth method; apt pulls in libkrb5-3,
#                     libk5crypto3, libkrb5support0, libkeyutils1, libcom-err2
#                     transitively.
# libldap-2.5-0     — libpq LDAP auth support. Bookworm ships -2.5; trixie
#                     ships -2.6 (see DEPLOYMENT.md §10 E — base image note).
#                     libsasl2-2 is pulled in transitively.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgssapi-krb5-2 \
        libldap-2.5-0 \
    && rm -rf /var/lib/apt/lists/*

# PG 18 binaries. backup_production_db.py only calls pg_dump; pg_restore is
# included for completeness (DR drills, manual use). psql is omitted — not
# needed by the cron script.
COPY --from=builder /usr/lib/postgresql/18/bin/pg_dump    /usr/local/bin/pg_dump
COPY --from=builder /usr/lib/postgresql/18/bin/pg_restore /usr/local/bin/pg_restore

# libpq.so.5 from the PGDG PG18 build. Debian main only ships the PG15
# variant; pg_dump links against the PGDG libpq (PG18 wire protocol).
# Wildcard picks up both the versioned .so.5.N file and the .so.5 name so
# that ldconfig can map the SONAME correctly.
#
# If the pg_dump --version smoke test below fails with
# "error while loading shared libraries", run:
#   docker run --rm --entrypoint /bin/bash <builder-image-id> \
#     -c "ldd /usr/lib/postgresql/18/bin/pg_dump"
# and add a COPY line for any "not found" library.
COPY --from=builder /usr/lib/x86_64-linux-gnu/libpq.so.5* /usr/lib/x86_64-linux-gnu/

# Refresh ldconfig cache so the dynamic linker finds the just-copied libpq.
# Build-time smoke test: fails the docker build immediately on any missing .so.
RUN ldconfig && pg_dump --version

WORKDIR /app

# Flush stdout immediately so Railway's log panel shows progress lines
# instead of a single dump at the end. Same rationale as Dockerfile:49.
ENV PYTHONUNBUFFERED=1

# Install the cron-service-only Python deps (boto3). pip-installed
# directly (no uv) — single-line requirements file, no need for the
# uv lockfile machinery here.
COPY scripts/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy only the backup script. The restore script is for DR drills
# (Smadar runs it manually); not needed in the cron image.
COPY scripts/backup_production_db.py /app/backup_production_db.py

# Run once and exit. Railway re-invokes per Cron Schedule —
# DO NOT loop, sleep, or daemonize.
CMD ["python", "/app/backup_production_db.py"]
