# ============================================================================
# מהמקור — Backend environment variables
# ============================================================================
# Copy to `.env` for local dev, or paste each KEY=value into Railway's
# service Variables tab for production.
#
# NOTE: Railway auto-injects DATABASE_URL when you link a PostgreSQL plugin;
# you do NOT need to set it manually in Railway. For local dev via
# docker-compose, DATABASE_URL is injected by docker-compose.yml.
# ============================================================================

# --- Database -----------------------------------------------------------------
# Local (docker-compose uses this automatically):
#   postgresql://postgres:postgres@db:5432/mehamakor
# Railway auto-injects the real value from the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mehamakor

# --- Auth / JWT ---------------------------------------------------------------
# SECURITY: never commit the real value to this file — it's tracked in git
# and leaking a signing key lets an attacker mint admin JWTs. Generate once
# per environment, paste directly into Railway's Variables tab.
#
# Generate with (256-bit hex, exactly HS256's key size):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Or URL-safe base64 (also fine):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-do-not-commit-the-real-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google OAuth -------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=591935721343-jjrco2vpmok72to1fm8rq1ss0i2s0cj7.apps.googleusercontent.com

# --- Apple Sign In ------------------------------------------------------------
APPLE_CLIENT_ID=

# --- Cloudinary (image uploads) -----------------------------------------------
# From https://console.cloudinary.com/ → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Twilio WhatsApp (admin notifications) ------------------------------------
# From https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+972500000000

# --- SMTP (admin emails) ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Admin account ------------------------------------------------------------
# Seeded on first boot (see seed_data.py) AND used as the SMTP recipient for
# admin notifications. If either is blank, the admin seed is skipped.
#
# SECURITY: do NOT commit the real password. Set these in Railway Variables.
# After first successful boot, rotate the password via the /admin UI — at
# that point you can remove ADMIN_PASSWORD from Railway entirely (the seed
# is idempotent and won't touch an existing admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Contact form inbox -------------------------------------------------------
# Destination for public POST /contact submissions. Set this to the inbox
# that should receive public contact-form traffic; falls back to ADMIN_EMAIL
# when unset. The backend sends mail via the SMTP_* credentials above; if
# SMTP is unconfigured or sending fails, the submission is still persisted
# to the `contact_messages` table (fail-open).
#
# Current canonical inbox (April 2026): levismadar80@gmail.com. SMTP_USER
# should also be set to this address so the From: header matches and Gmail
# doesn't flag the message as spoofed.
CONTACT_EMAIL=levismadar80@gmail.com

# --- Frontend URL (used for CORS + email links) -------------------------------
# Local:       http://localhost:3000
# Production:  https://mehamakor.online
FRONTEND_URL=https://mehamakor.online

# --- Trusted proxy for rate limiting (MEH-256) --------------------------------
# Set to "1" ONLY when this server sits behind a trusted reverse proxy
# (Railway edge, Cloudflare, nginx) that is known to overwrite or strip
# `X-Forwarded-For` on ingress. When enabled, the rate limiter honors the
# first XFF value as the real client IP so per-user limits (login 5/min,
# register 3/hour, etc.) isolate correctly instead of all users sharing
# one bucket keyed on the proxy IP.
#
# Leave unset (or "0") for local dev and any directly-exposed deploy —
# trusting a client-controlled header there lets attackers bypass limits
# by sending a forged XFF.
#
# Railway production + staging: TRUSTED_PROXY=1
# Local dev: leave unset.
TRUSTED_PROXY=0
