# ============================================================================
# מהמקור — Backend environment variables
# ============================================================================
# Copy to `.env` for local dev, or paste each KEY=value into Railway's
# service Variables tab for production.
#
# NOTE: Railway auto-injects DATABASE_URL when you link a PostgreSQL plugin;
# you do NOT need to set it manually in Railway. For local dev via
# docker-compose, DATABASE_URL is injected by docker-compose.yml.
# ============================================================================

# --- Database -----------------------------------------------------------------
# Local (docker-compose uses this automatically):
#   postgresql://postgres:postgres@db:5432/mehamakor
# Railway auto-injects the real value from the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mehamakor

# --- Auth / JWT ---------------------------------------------------------------
# SECURITY: never commit the real value to this file — it's tracked in git
# and leaking a signing key lets an attacker mint admin JWTs. Generate once
# per environment, paste directly into Railway's Variables tab.
#
# Generate with (256-bit hex, exactly HS256's key size):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Or URL-safe base64 (also fine):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-do-not-commit-the-real-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google OAuth -------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=591935721343-jjrco2vpmok72to1fm8rq1ss0i2s0cj7.apps.googleusercontent.com

# --- Apple Sign In ------------------------------------------------------------
APPLE_CLIENT_ID=

# --- Cloudinary (image uploads) -----------------------------------------------
# From https://console.cloudinary.com/ → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Twilio WhatsApp (admin notifications) ------------------------------------
# From https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+972500000000

# --- Email — Resend HTTP API --------------------------------------------------
# Railway blocks SMTP (ports 25/465/587). All email goes through Resend.
# 1. Sign up at https://resend.com
# 2. Add mehamakor.online → verify the DNS records Resend shows you
# 3. Create an API key → paste below (or set in Railway Variables tab)
RESEND_API_KEY=

# --- Admin account ------------------------------------------------------------
# Seeded on first boot (see seed_data.py) AND used as the Resend recipient for
# admin notifications. If either is blank, the admin seed is skipped.
#
# SECURITY: do NOT commit the real password. Set these in Railway Variables.
# After first successful boot, rotate the password via the /admin UI — at
# that point you can remove ADMIN_PASSWORD from Railway entirely (the seed
# is idempotent and won't touch an existing admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Contact form inbox -------------------------------------------------------
# Destination for public POST /contact submissions. Set this to the inbox
# that should receive public contact-form traffic; falls back to ADMIN_EMAIL
# when unset. The backend sends mail via Resend; if RESEND_API_KEY is unset
# or sending fails, the submission is still persisted to the
# `contact_messages` table (fail-open).
CONTACT_EMAIL=levismadar80@gmail.com

# --- Frontend URL (used for CORS + email links) -------------------------------
# Override per environment. NEVER copy production value to staging.
# Local:       http://localhost:3000
# Staging:     https://staging.mehamakor.online
# Production:  https://mehamakor.online
FRONTEND_URL=https://mehamakor.online

# MEH-453: FROM address used by Resend. Override per env (Phase 2 flips
# the production default to noreply@mehamakor.co.il).
EMAIL_FROM_ADDRESS=מהמקור <noreply@mehamakor.online>

# --- Web Push (VAPID) ---------------------------------------------------------
# MEH-453: env-aliased so Phase 2 can flip to admin@mehamakor.co.il without
# a code change. pydantic-settings reads VAPID_SUBJECT into vapid_subject.
VAPID_SUBJECT=mailto:admin@mehamakor.online

# --- Database environment URLs (MEH-408 Phase 3) ------------------------------
# Resolved by app/config.py:_load_settings() based on ENV. Set the matching
# one in Railway per environment; DATABASE_URL above is the local-dev fallback.
DATABASE_URL_PRODUCTION=
DATABASE_URL_STAGING=

# --- Auth / JWT additional settings -------------------------------------------
# MEH-326: refresh token TTL paired with the 15-min access token. 14 days
# matches the "stay signed in" UX; rotate the cookie on every refresh.
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Anthropic model selection ------------------------------------------------
# Override in Railway when bumping models. App default is claude-opus-4-6.
ANTHROPIC_MODEL=claude-opus-4-6

# --- Web Push (VAPID) — keypair ----------------------------------------------
# MEH-54: leave empty to disable push (fail-open — alerts still send via
# WhatsApp if the user has opted in). Generate with:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); \
#     print(v.private_pem().decode()); \
#     print(v.public_key.public_bytes_raw().hex())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# --- Observability (MEH-483) --------------------------------------------------
# structlog level + format. Default LOG_LEVEL=INFO, LOG_FORMAT=console in dev
# / json in prod (auto-selected from ENV).
LOG_LEVEL=INFO
LOG_FORMAT=

# --- Rate limit (MEH-335 fingerprint hardening) -------------------------------
# Set to "1" in front-of-proxy environments (Railway) so X-Forwarded-For
# is trusted. "0" in local dev where the request lands direct.
TRUSTED_PROXY=0

# --- Runtime port (Railway) ---------------------------------------------------
# Railway injects PORT=8080 into the container. The Dockerfile binds uvicorn
# to ${PORT:-8000} so local dev defaults to 8000. Locked decision: never
# change Railway's Target Port from 8080 (see docs/LOCKED_DECISIONS.md).
PORT=8000

# --- Sentry (MEH-500) ---------------------------------------------------------
# Backend Sentry SDK init via app/sentry.py:init_sentry(). Wires the
# MEH-483/MEH-493 SentryRequestScopeMiddleware shim. Leave DSN empty to
# disable (fail-open — middleware continues to no-op, app boots normally).
BACKEND_SENTRY_DSN=

# Release tag priority: APP_VERSION (explicit) > RAILWAY_GIT_COMMIT_SHA
# (Railway-injected, in SYSTEM_EXCLUDE) > "unknown". Set APP_VERSION in
# Railway only when shipping a tagged release; otherwise the auto-injected
# git SHA is the right default.
APP_VERSION=
