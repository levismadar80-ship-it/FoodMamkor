# ==============================================================
# MeHaMakor — environment variables for docker-compose
# ==============================================================
# Copy this file to `.env` (no extension) in the SAME directory as
# docker-compose.yml, then fill in real values. `.env` is git-ignored.
#
# docker-compose picks up `.env` automatically — no extra flags needed.
# After editing, run:
#   docker-compose down
#   docker-compose build --no-cache backend frontend
#   docker-compose up

# ==============================================================
# REQUIRED in production — the backend refuses to boot without these
# ==============================================================

# Set to "production" to enable strict mode (fail-fast on missing secrets,
# stricter CORS check). Leave as "development" locally.
ENV=development

# 64-char hex string used to sign JWTs. MUST be set in production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave EMPTY in development — an ephemeral random secret is generated
# per process and tokens invalidate on each restart (that's fine locally).
JWT_SECRET_KEY=

# Comma-separated origins allowed by CORS. Production MUST restrict.
# Dev default includes localhost:3000 only.
CORS_ORIGINS=http://localhost:3000,https://mehamekor.co.il,https://www.mehamekor.co.il

# ==============================================================
# Optional — features silently degrade without these
# ==============================================================

# Anthropic — powers home-product AI moderation (MODERATION.md).
# Without this, every listing is auto-APPROVED + logged.
ANTHROPIC_API_KEY=

# Cloudinary — image uploads. Without this, uploads return a local
# placeholder URL instead of hitting Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth — Google + Apple sign-in. If either is empty the login page
# hides the corresponding button gracefully.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
